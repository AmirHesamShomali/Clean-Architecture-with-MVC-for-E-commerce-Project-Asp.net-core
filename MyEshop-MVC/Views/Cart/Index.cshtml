@using MyEshop_Domain.Entities.Cart
@model IEnumerable<Cart>;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-cart3 fs-2 text-primary me-2"></i>
        <h1 class="h3 fw-bold mb-0">سبد خرید</h1>
    </div>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-primary">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">نام محصول</th>
                        <th scope="col">تعداد</th>
                        <th scope="col">قیمت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td class="text-muted">@i.Id</td>
                            <td class="fw-medium">@i.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-info text-dark">
                                    <i class="bi bi-box-fill me-1"></i>@i.Count
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-success">@i.Price.ToString("N0")</span>
                                <small class="text-muted">تومان</small>
                            </td>
                            <td>
                                <form method="post" asp-action="RemoveFromCart" asp-controller="Cart" asp-route-cat_id="@i.Id">
                                    <input type="hidden" name="cartId" value="@i.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3 me-1"></i>حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card shadow-sm border-0 mb-4 bg-gradient bg-primary text-white">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fs-5 fw-bold">جمع کل</span>
            <span class="fs-5 fw-bold">
                <i class="bi bi-coin me-1"></i>
                @ViewBag.SumOfPrice.ToString("N0") تومان
            </span>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <form method="post">
            <button type="submit" class="btn btn-success btn-lg px-4">
                <i class="bi bi-credit-card me-2"></i>پرداخت و ثبت سفارش
            </button>
        </form>
    </div>
</div>

