
@{
    ViewData["Title"] = "Success";
}
<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="card shadow-sm p-5 text-center" style="max-width: 500px; border-radius: 15px;">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
        </div>
        <h2 class="mb-3 text-dark">سفارش شما با موفقیت ثبت شد</h2>

        <p class="text-muted mb-4">
            کاربر عزیز، درخواست سفارش شما با موفقیت دریافت شد.
            پس از بررسی توسط تیم پشتیبانی، وضعیت خرید شما از طریق <strong>پیامک</strong> به اطلاع‌تان خواهد رسید.
        </p>

        <div class="alert alert-light border" role="alert">
            از صبر و شکیبایی شما سپاسگزاریم.
        </div>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">بازگشت به صفحه اصلی</a>
        </div>
    </div>
</div>


