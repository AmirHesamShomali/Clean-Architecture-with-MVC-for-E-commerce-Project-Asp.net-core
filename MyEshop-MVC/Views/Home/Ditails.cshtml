@using MyEshop_Domain.Entities.Products
@model Product;
@{
    ViewData["Title"] = "Ditail";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-wrap hero-bread" style="background-image: url('/assets-page/pics/bg_1.jpg');">
	<div class="container">
		<div class="row no-gutters slider-text align-items-center justify-content-center">
			<div class="col-md-9 ftco-animate text-center">
				<p class="breadcrumbs"><span class="mr-2"><a href="index.html">خانه</a></span> </p>
				<h1 class="mb-0 bread">محصولات تکی</h1>
			</div>
		</div>
	</div>
</div>

<form asp-action="index" asp-controller="Cart" asp-route-product_id="@Model.Id" method="post">
	<input type="text" id="Emailuser" name="Emailuser" class="form-control input-number" value="@User.Identity.Name">
<section class="ftco-section">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 mb-5 ftco-animate">
				<a href=@Model.ImagePath class="image-popup"><img src=@Model.ImagePath class="img-fluid" alt="Colorlib Template"></a>
			</div>
			<div class="col-lg-6 product-details pl-md-5 ftco-animate">
				<h3>@Model.Name</h3>
				<div class="rating d-flex">
					<p class="text-left mr-4">
						<a href="#" class="mr-2">5.0</a>
						<a href="#"><span class="ion-ios-star-outline"></span></a>
						<a href="#"><span class="ion-ios-star-outline"></span></a>
						<a href="#"><span class="ion-ios-star-outline"></span></a>
						<a href="#"><span class="ion-ios-star-outline"></span></a>
						<a href="#"><span class="ion-ios-star-outline"></span></a>
					</p>
					<p class="text-left mr-4">
						<a href="#" class="mr-2" style="color: #000;">100 <span style="color: #bbb;">رای</span></a>
					</p>
					<p class="text-left">
						<a href="#" class="mr-2" style="color: #000;">500 <span style="color: #bbb;">فروخته شده</span></a>
					</p>
				</div>
				<p class="price"><span>@Model.Price تومان</span></p>
				<p>
					@Model.Description
				</p>
				<div class="row mt-4">
					</div>
					<div class="w-100"></div>
					<div class="input-group col-md-6 d-flex mb-3">
						<span class="input-group-btn mr-2">
							<button type="button" class="quantity-left-minus btn" data-type="minus" data-field="">
								<i class="ion-ios-remove"></i>
							</button>
						</span>
						<input type="number" id="quantity" name="quantity" class="form-control input-number" value="1" min="1" max="100">
						<span class="input-group-btn ml-2">
							<button type="button" class="quantity-right-plus btn" data-type="plus" data-field="">
								<i class="ion-ios-add"></i>
							</button>
						</span>
					</div>
					<div class="w-100"></div>
					<div class="col-md-12">
						<p style="color: #000;">موجودی 600 کیلوگرم</p>
					</div>
				</div>
			<button type="submit" class="btn btn-black py-3 px-5">اضافه به سبد خرید </button>
			</div>
		</div>
	</div>
</section>
</form>

