@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Application.Services.Users.Commands.RegisterUser;
@model RequestRegisterService;
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container mt-5">
    <div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
        <h3 class="mb-4 text-center">ثبت‌نام کاربر</h3>
        <form method="post" asp-action="create" asp-controller="Users">
            <div class="mb-3">
                <label class="form-label">نام و نام خانوادگی</label>
                <input type="text" class="form-control" placeholder="مثال: علی علوی" asp-for="@Model.FullName">
                <span asp-validation-for="@Model.FullName" class="text-danger text-center"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">تلفن</label>
                <input type="text" class="form-control" asp-for="@Model.phone" placeholder="09111111111">
                <span asp-validation-for="@Model.phone" class="text-danger text-center"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">رمز عبور</label>
                <input type="password" class="form-control" asp-for="@Model.Password">
                <span asp-validation-for="@Model.Password" class="text-danger text-center"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">تکرار رمز عبور</label>
                <input type="password" class="form-control" asp-for="@Model.Repassword">
                <span asp-validation-for="@Model.Repassword" class="text-danger text-center"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsAdmin" class="form-check-input" type="checkbox" id="isAdminCheck">
                <label class="form-check-label" for="isAdminCheck">دسترسی ادمین (Admin)</label>
            </div>


            <button type="submit" class="btn btn-primary w-100 mt-3">ثبت اطلاعات</button>

            <h1 class="text-danger text-center">
                @ViewBag.Message
            </h1>
        </form>
    </div>
    @section Scripts
    {
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    }
</div>
