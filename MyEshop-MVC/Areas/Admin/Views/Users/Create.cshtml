@using MyEshop_Application.Services.Users.Queries.GetRoles;
@model IEnumerable<RolesDto>
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container mt-5">
    <div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
        <h3 class="mb-4 text-center">ثبت‌نام کاربر</h3>
        <form>
            <div class="mb-3">
                <label class="form-label">نام و نام خانوادگی</label>
                <input type="text" class="form-control" placeholder="مثال: علی علوی">
            </div>
            <div class="mb-3">
                <label class="form-label">ایمیل</label>
                <input type="email" class="form-control" placeholder="example@mail.com">
            </div>
            <div class="mb-3">
                <label class="form-label">رمز عبور</label>
                <input type="password" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label">تکرار رمز عبور</label>
                <input type="password" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label">انتخاب نقش</label>
                <select class="form-select">
                    <option selected disabled>نقش خود را انتخاب کنید...</option>
                    @foreach(var i in Model)
                    {
                    <option value="admin">@i.Name</option>
                        
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">ثبت اطلاعات</button>
        </form>
    </div>
</div>
