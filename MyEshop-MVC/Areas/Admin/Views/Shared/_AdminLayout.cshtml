@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="~/assets/css/style.css" rel="stylesheet" />
        <link href="~/assets/css/bootstrap.css" rel="stylesheet" />
        <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/assets/fontawesome/css/all.css" rel="stylesheet" />
        <title>پنل ادمین-فروشگاه من</title>
    </head>
</head>
<body style="background:none">
    <header>
        <nav class="navbar fixed-top navbar-dark bg-secondary top_navbar py-0">
            <div class="container-fluid h-100 pe-0">

                 <div class="right_content h-100 py-1 bg-dark">
                    <a class="navbar-brand h-100" href="/">
                        <img src="~/assets-page/pics/bg_1.jpg" class="h-100" />
                    </a>
                    <div class="form-check form-switch mx-4 d-none d-md-block">
                        <input id="handle_toggle_sidemenu" class="form-check-input pointer" type="checkbox"
                               id="flexSwitchCheckChecked">
                    </div>
                </div>

                <div class="left_content d-flex flex-row-reverse">
                    <i class="fas fa-grip-vertical fa-2x me-3 pointer" id="dropdownMenuButton1" data-bs-toggle="dropdown"
                       aria-expanded="false"></i>

      
                    <ul class="dropdown-menu mini_menu" aria-labelledby="dropdownMenuButton1">
                        <li class="my-2"><a class="dropdown-item d-block text-center">@User.Identity.Name</a></li>
                        <li class="my-2 d-flex justify-content-center align-items-center px-2">
                            <i class="fas fa-tachometer-alt"></i>
                            <a class="dropdown-item" href="#">داشبورد</a>
                        </li>
                        <li class="my-2 d-flex justify-content-center align-items-center px-2">
                            <i class="fas fa-paper-plane"></i>
                            <a class="dropdown-item" href="#">تیکت ها</a>
                        </li>
                        <li class="my-2 d-flex justify-content-center align-items-center px-2">
                            <i class="fas fa-envelope"></i>
                            <a class="dropdown-item" href="#">پیام ها</a>
                        </li>
                        <hr />
                        <li class="d-flex justify-content-center align-items-center px-2">
                            <i class="fas fa-power-off"></i>
                            <a class="dropdown-item" href="#">خروج</a>
                        </li>
                    </ul>
                    <i class="far fa-bell fa-2x mx-3 pointer position-relative">
                        <span class="alarm_count">4</span>
                    </i>
                    <i class="fas fa-search fa-2x mx-3 pointer"></i>
                </div>

            </div>
        </nav>
    </header>
    </section>
    <!-- #region(collapsed) sidebar start -->
    <section id="sidebar_section">
        <div class="mini_sidebar collapsedd bg-dark h-100">
            <ul class="p-0 m-0">
                <li class="pt-1 pb-2 d-flex flex-column avatar_li position-relative">
                    <span class="avatar_box">
                        <img src="~/assets-page/pics/user.png" class="w-100 rounded-circle" />
                    </span>
                    <div class="sidebar_avatar_name text-center hiddenable">@User.Identity.Name</div>
                </li>
                <!-- =================================== -->
                <li class="py-1 text-start pe-4 sidebar_menu_item" data-section-id="manage_product_section">
                    <i class="ms-3 icon fas fa-cube text-light"></i>
                    <a style="display:inline-block; text-decoration:none" href="/admin/products">

                        <span class="hiddenable no_wrap font_08">مدیریت محصول</span>
                    </a>
                </li>
                <!-- =================================== -->
                <li class="py-1 text-start pe-4 sidebar_menu_item" data-section-id="manage_orders_section">
                    <i class="ms-3 icon fas fa-luggage-cart text-light"></i>
                    <a style="display:inline-block; text-decoration:none" href="/admin/order">
                    <div class="hiddenable no_wrap font_08">مدیریت سفارشات</div>
                    </a>
                </li>
                <!-- =================================== -->
                <li class="py-1 text-start pe-4 sidebar_menu_item">

                    <i class="ms-3 icon fas fa-users text-light"></i>
                    <a style="display:inline-block; text-decoration:none" href="/admin/users">
                        <div class="hiddenable no_wrap font_08">مشاهده کاربران</div>
                    </a>
                </li>
                 <!-- =================================== -->
                <li class="py-1 text-start pe-4 sidebar_menu_item">
                    
                    <i class="ms-3 icon fas fa-money-check-alt text-light"></i>
                    <a style="display:inline-block; text-decoration:none" href="/admin/payment">
                        <div class="hiddenable no_wrap font_08">مدیریت  پرداخت ها </div>
                    </a>
                </li>
                <!-- =================================== -->
                <li class="py-1 text-start pe-4 sidebar_menu_item" data-section-id="manage_comments_section">
                    <i class="ms-3 icon fas fa-comment text-light"></i>
                    <a style="display:inline-block; text-decoration:none" href="/admin/Comment">

                    <span class="hiddenable no_wrap font_08">نظرات</span>
                    </a
                </li>
            </ul>
        </div>
    </section>
    <!-- #endregion -->

    <div class="container">
        <main role="main" class="pb-3" style="z-index:200px">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/chart.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>
