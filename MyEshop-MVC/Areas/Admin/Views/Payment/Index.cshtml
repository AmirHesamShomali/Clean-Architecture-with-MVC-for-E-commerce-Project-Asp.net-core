@using MyEshop_Domain.Entities.Payment;
@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}
<div id="manage_user_section" class="manage_user_section main_section" style="margin-top:80px">
    <h2 text-warning>
        @ViewData["Message"]
    </h2>
    <h4 class="text-center my-3">مدیریت پرداخت ها </h4>
    <div class="row justify-content-between">
        <div class="col-10 col-md-6 col-lg-4">
            <div class="input-group mb-3" style="direction: ltr;">
                <input type="text" class="form-control" placeholder="قسمتی از پرداختی را وارد کنید">
                <span class="input-group-text">جستجو</span>
            </div>
        </div>
    </div>
    <table class="table table-responsive text-center table-hover table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>#</th>
                <th>نام و نام خانوادگی کاربر</th>
                <th>زمان پرداخت</th>
                <th>تاییدیه پرداخت</th>
                <th>مبلغ کل پرداخت پرداخت</th>

            </tr>
        </thead>
        <tbody>


            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.UserName</td>
                    <td>@i.TimeSubmit</td>
                    <td>
                        @if (@i.Success==true)
                        {
                            <i class="fas fa-check text-success  mx-1 hoverable_text pointer has_tooltip"></i>
                        }
                        else
                        {
                              <i class="fas fa-times text-danger mx-1 hoverable_text pointer has_tooltip"></i>
                        }

                    
                    </td>
                    <td>@i.TotalPrice تومان</td>
                </tr>

            }
        </tbody>
    </table>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center">
        <ul class="pagination dir_ltr">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>




