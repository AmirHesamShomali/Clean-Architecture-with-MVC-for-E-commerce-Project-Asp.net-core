@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Domain.Entities.Comment;
@model Comment
@{
    ViewData["Title"] = "AddComment";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
        <h3 class="mb-4 text-center">‌اضافه کردن کامنت</h3>
        <form method="post" asp-action="AddComment" asp-controller="Comment">
            <div class="mb-3">
                <label class="form-label">نام و نام خانوادگی</label>
                <input type="text" class="form-control" asp-for="@Model.Name">
                <span class="text-danger text-center"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">توضیحات</label>
                <input type="text" class="form-control" asp-for="@Model.Description">
                <span class="text-danger text-center"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">ثبت اطلاعات</button>
        </form>

    </div>
