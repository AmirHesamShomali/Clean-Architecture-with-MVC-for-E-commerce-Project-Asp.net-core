@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Domain.Entities.Comment;
@model IEnumerable<Comment>;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div id="manage_user_section" class="manage_user_section main_section">
    <h2 text-warning>
        @ViewData["Message"]
    </h2>
    <h4 class="text-center my-3">مدیریت کامنت ها</h4>
    <div class="row justify-content-between">
        <div class="col-10 col-md-6 col-lg-4">
            <div class="input-group mb-3" style="direction: ltr;">
                <input type="text" class="form-control" placeholder="قسمتی از کامنت   را وارد کنید">
                <span class="input-group-text">جستجو</span>
            </div>
        </div>
        <div class="col-2 col-md-6 col-lg-4 d-flex flex-column align-items-end">
            <a asp-action="AddComment" asp-controller="Comment">

                <button class="btn btn-success d-flex justify-content-center align-items-center">
                    <i class="fas fa-plus text-light"></i>
                </button>
            </a>
        </div>
    </div>
    <table class="table table-responsive text-center table-hover table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>#</th>
                <th>نام مشتری </th>
                <th>کامنت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>


            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.Name</td>
                    <td>@i.Description</td>

                    <td>
                        <a asp-action="Delete" asp-controller="Comment" asp-route-comment_id="@i.Id">
                            <i class="fas fa-times text-danger mx-1 hoverable_text pointer has_tooltip"
                               title="حذف کامنت"></i>


                        </a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center">
        <ul class="pagination dir_ltr">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>