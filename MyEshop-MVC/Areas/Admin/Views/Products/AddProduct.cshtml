@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Domain.Entities.Products
@model RequestAddProduct
@{
    ViewData["Title"] = "AddProduct";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
        <h3 class="mb-4 text-center">‌اضافه کردن محصول</h3>
        <form method="post" asp-action="AddProduct" asp-controller="Products" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">نام محصول </label>
                <input type="text" class="form-control" asp-for="Name">
                <span class="text-danger text-center"></span>
                <span class="text-danger text-center"></span>
            </div>


            <div class="mb-3">
                <label class="form-label">قسمت توضیحات</label>
                <input type="text" class="form-control" asp-for="Description">
                <span class="text-danger text-center"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">قیمت</label>
                <input type="text" class="form-control" asp-for="Price">
                <span class="text-danger text-center"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">دسته‌بندی</label>
                <select class="form-select" asp-for="CategoryId">
                    <option value=""> انتخاب کنید </option>

                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }

                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">عکس محصول</label>
                <input type="file" class="form-control" name="imagefile">
                <span class="text-danger text-center"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">ثبت اطلاعات</button>
        </form>

    </div>

