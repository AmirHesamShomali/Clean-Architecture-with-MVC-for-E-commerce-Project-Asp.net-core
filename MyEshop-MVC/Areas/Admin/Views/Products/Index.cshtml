@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Application.Services.Products.Queries.GetProducts;
@model ResaultProductService;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}


<div id="manage_user_section" class="manage_user_section main_section" style="margin-top:80px">
    <h2 text-warning>
        @ViewData["Message"]
    </h2>
    <h4 class="text-center my-3">مدیریت محصولات</h4>
    <div class="row justify-content-between">
        <div class="col-10 col-md-6 col-lg-4">
            <form method="post" asp-action="SerchProduct" asp-controller="Products">
                <div class="input-group mb-3" style="direction: ltr;">
                    <input type="text" class="form-control" placeholder="قسمتی از نام   را وارد کنید" name="SearchString" id="SearchString">
                    <button class="input-group-text">جستجو</button>
                </div>
            </form>
        </div>
        <div class="col-2 col-md-6 col-lg-4 d-flex flex-column align-items-end">
            <a asp-action="AddProduct" asp-controller="Products">

                <button class="btn btn-success d-flex justify-content-center align-items-center">
                    <i class="fas fa-plus text-light"></i>
                </button>
            </a>
        </div>
    </div>
    <table class="table table-responsive text-center table-hover table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>#</th>
                <th>نام محصول </th>
                <th>قیمت</th>
                <th>توضیحات</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>


            @foreach (var i in Model.Products)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.Name</td>
                    <td>@i.Price</td>
                    <td>@i.Description</td>

                    <td>
                        <a asp-action="Edit" asp-controller="Products" asp-route-product_id="@i.Id">
                            >

                            <i class="fas fa-edit text-warning mx-1 hoverable_text pointer has_tooltip"
                               title="جزئیات و ویرایش کاربر" data-bs-toggle="modal"></i>
                        </a>
                        <a asp-action="Delete" asp-controller="Products" asp-route-product_id="@i.Id">
                            <i class="fas fa-times text-danger mx-1 hoverable_text pointer has_tooltip"
                               title="حذف کاربر"></i>


                        </a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center">
        <ul class="pagination dir_ltr">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>



