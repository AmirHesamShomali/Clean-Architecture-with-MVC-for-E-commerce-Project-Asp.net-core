@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Domain.Entities.Order
@model IEnumerable<Order>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}




<div id="manage_user_section" class="manage_user_section main_section" style="margin-top:80px">
    <h4 class="text-center my-3">مدیریت سفارش های جدید </h4>
    <div class="row justify-content-between">
        <div class="col-10 col-md-6 col-lg-4">
            <div class="input-group mb-3" style="direction: ltr;">
                <input type="text" class="form-control" placeholder="قسمتی از پرداختی را وارد کنید">
                <span class="input-group-text">جستجو</span>
            </div>
        </div>
    </div>
    <table class="table table-responsive text-center table-hover table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>#</th>
                <th>نام و نام خانوادگی کاربر</th>
                <th>تلفن کاربر</th>
                <th>نام کالا جدید</th>
                <th>عکس محصول</th>
                <td>عملیات</td>


            </tr>
        </thead>
        <tbody>


            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.User_Name</td>
                    <td>@i.Phone</td>
                    <td>@i.Product_Name</td>
                    <td>
                        <img src="@i.ImagePath"
                             class="img-thumbnail shadow-sm"
                             style="width: 70px; height: 70px; object-fit: cover;"
                             alt="تصویر محصول" />
                    </td>
                    <td>
                        <a asp-action="AddProducttoCart" asp-controller="order" asp-route-phone_number="@i.Phone">

                            <i  class="fas fa-edit text-warning mx-1 hoverable_text pointer has_tooltip"
                               title="افزودن محصول به سبد خرید کاربر" data-bs-toggle="modal"></i>
                        </a>
                        <a asp-action="Deletorder" asp-controller="order" asp-route-order_id="@i.Id">
                            <i class="fas fa-times text-danger mx-1 hoverable_text pointer has_tooltip"
                               title="حذف "></i>


                        </a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center">
        <ul class="pagination dir_ltr">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

