@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MyEshop_Application.Services.Orders.Command.AddProducttoCart
@model RequestAddProducttoCart
@{
    ViewData["Title"] = "افزودن کالا به سبد خرید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container" style="margin-top:80px">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0"><i class="bi bi-cart-plus"></i> افزودن کالا به سبد خرید</h4>
                </div>
                <div class="card-body">
                    <form asp-action="AddProducttoCart" method="post">
                        <input type="hidden" name="phonenumber" id="phonenumber" value="@ViewBag.phone_number" />
                        <div class="mb-3">
                            <label for="name" class="form-label">نام کالا</label>
                            <input type="text" asp-for="@Model.Name" class="form-control" id="name" name="Name" placeholder="مثلاً: لپ تاپ ایسوس" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="price" class="form-label">قیمت (تومان)</label>
                                <input type="number" asp-for="@Model.Price" class="form-control" id="price" name="Price" placeholder="0" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="count" class="form-label">تعداد</label>
                                <input type="number" asp-for="@Model.Count" class="form-control" id="count" name="Count" value="1" min="1" required>
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> افزودن به سبد خرید
                            </button>
                        </div>

                    </form>
                </div>
                <div class="card-footer text-muted text-center">
                    <small>لطفاً اطلاعات را به دقت وارد کنید</small>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        direction: rtl;
        text-align: right;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-label {
        font-weight: bold;
    }
</style>