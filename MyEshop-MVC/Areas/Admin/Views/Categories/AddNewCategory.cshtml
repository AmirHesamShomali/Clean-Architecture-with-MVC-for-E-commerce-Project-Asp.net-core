@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MyEshop_Application.Services.Products.Command.Addnewcategory.RequestCategories;
@{

    ViewData["Title"] = "AddNewCategory";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}

<div class="container mt-5">
    <div class="card shadow-sm p-4" style="max-width: 500px; margin: auto;">
        <h3 class="mb-4 text-center">اضافه کردن دسته بندی</h3>
        <form method="post" asp-action="AddNewCategory" asp-controller="Categories">
            <input type="hidden" asp-for="@Model.parentid" />
            <div class="mb-3">
                <label class="form-label">نام دسته بندی</label>
                <input type="text" class="form-control" asp-for="@Model.Name" />
                <span class="text-danger text-center"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-3">ثبت اطلاعات</button>
        </form>

    </div>
</div>

